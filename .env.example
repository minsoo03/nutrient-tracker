# Nutrient Tracker — 환경 변수 템플릿
# 사용법: 이 파일을 ".env"로 복사한 뒤 아래 값들을 실제 값으로 채워주세요.
#   cp .env.example .env
#
# Supabase 프로젝트 만들기:
#   https://supabase.com → New project → Settings → API
# 공공데이터포털 API 키 신청:
#   https://www.data.go.kr → "식품영양성분 DB" 검색 → 활용신청

# --- Supabase (필수) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- 공공데이터포털 / 식약처 API (음식 검색 기능에 필요) ---
DATA_API_KEY=YOUR_DATA_GO_KR_SERVICE_KEY

# --- (선택) MFDS 별도 키 — 없으면 DATA_API_KEY가 fallback ---
# MFDS_API_KEY=YOUR_MFDS_KEY

# --- (선택) 약품 정보 별도 키 — 없으면 DATA_API_KEY가 fallback ---
# DRUG_API_KEY=YOUR_DRUG_KEY

# --- (개발용 - production에선 비워두세요) ---
# DEV_TEST_EMAIL=
# DEV_TEST_PASSWORD=
